PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=vspark
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_SECRET=change-me-min-32-chars
REFRESH_SECRET=change-me-different-min-32-chars
# Only needed if the public page is served from another domain (comma separated)
ALLOWED_ORIGINS=

# Optional: creates/updates the superadmin automatically on every start (min 8 chars password)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Railway MySQL: either set MYSQL_URL=${{MySQL.MYSQL_URL}} or the DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME variables
